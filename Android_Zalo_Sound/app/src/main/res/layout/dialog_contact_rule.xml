<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_add_vip_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_contact_name"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etContactName"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_status_badge"
            android:backgroundTint="#2D3540"
            android:hint="@string/hint_contact_name"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lưu ý: Nhập chính xác tên hiển thị của người này trên thông báo Zalo."
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_select_sound"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="16dp" />

        <Spinner
            android:id="@+id/spinnerDialogSound"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/primary"
            android:popupBackground="@color/card_dark" />

        <TextView
            android:id="@+id/tvDialogCustomFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="File: Chưa chọn file"
            android:textColor="@color/primary_light"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnDialogTestSound"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="▶ Nghe thử"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/primary" />

            <Button
                android:id="@+id/btnDialogPickCustom"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Chọn file..."
                android:textAllCaps="false"
                android:textSize="13sp"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_secondary"
                android:backgroundTint="@color/card_stroke" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_stroke"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnDialogCancel"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="@string/btn_cancel"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:backgroundTint="@color/card_stroke"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btnDialogSave"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="@string/btn_save"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/primary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
