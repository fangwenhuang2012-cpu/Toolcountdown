<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="12dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIETMAP TS-C1 LIVE RECORDER"
                android:textColor="#38BDF8"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWifiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi: Đang quét tìm Cam TS-C1..."
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- FPS & Mode Pill Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvFpsBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#0284C7"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="0 FPS"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStreamModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mode: Tự động"
                android:textColor="#38BDF8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Live Video Display Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <!-- Live Camera Frame View -->
        <ImageView
            android:id="@+id/ivCameraLive"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Live Camera Feed"
            android:scaleType="fitCenter" />

        <!-- Placeholder & Connecting Indicator -->
        <LinearLayout
            android:id="@+id/layoutConnecting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/pbLoading"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/tvWaitingMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Đang kết nối Camera VietMap TS-C1..."
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubWaitingMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Đang gửi chuỗi lệnh kích hoạt Novatek (Port 80/8192)..."
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Stats Overlay Bar at bottom of Video -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#99000000"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView
                android:id="@+id/tvResolutionStats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kích thước: Đang chờ frame..."
                android:textColor="#E2E8F0"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvFrameCountStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã nhận: 0 frames"
                android:textColor="#38BDF8"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Action Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnHandshake"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="#0284C7"
            android:text="⚡ Kích hoạt Cam"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSwitchEngine"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="#334155"
            android:text="🔄 Đổi Luồng"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSnapshotTest"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="#334155"
            android:text="📸 Test Ảnh"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnStartFloating"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.2"
            android:layout_marginStart="4dp"
            android:background="#16A34A"
            android:text="🪟 Mở HUD Nổi"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Log / Diagnostics Console Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_marginTop="6dp"
        android:background="#1E293B"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NHẬT KÝ KẾT NỐI CAMERA &amp; MẠNG (DUAL-NETWORK LOG)"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/svLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Khởi tạo ứng dụng..."
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
