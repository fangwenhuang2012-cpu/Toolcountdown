<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090D16"
    android:keepScreenOn="true"
    android:padding="8dp">

    <!-- Top Dashboard Header -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/viewLiveStatusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="#EF4444" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIETMAP LIVE CAMERA"
                    android:textColor="#38BDF8"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWifiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Wi-Fi: Đang kiểm tra..."
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- FPS & Protocol Badges -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvFpsBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#0284C7"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="0 FPS"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStreamProtocolBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mode: Tự động"
                android:textColor="#38BDF8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Camera Video Feed Area -->
    <FrameLayout
        android:id="@+id/layoutVideoContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <!-- Live Camera Image View -->
        <ImageView
            android:id="@+id/ivCameraFeed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Live Camera Video Stream"
            android:scaleType="fitCenter" />

        <!-- Connecting / Waiting State -->
        <LinearLayout
            android:id="@+id/layoutConnecting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/tvConnectingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Đang kết nối Camera VietMap..."
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConnectingSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Đang gửi Handshake Novatek (Port 80/8192)..."
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Bottom Mini Stats Bar -->
        <LinearLayout
            android:id="@+id/layoutVideoStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#88000000"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tvVideoResolution"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Độ phân giải: Đang chờ frame..."
                android:textColor="#E2E8F0"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvFrameCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khung hình: 0"
                android:textColor="#38BDF8"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Controls Toolbar -->
    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <!-- Button 1: Handshake / Reconnect -->
        <Button
            android:id="@+id/btnHandshake"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="#0284C7"
            android:text="⚡ Kích Hoạt Cam"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Button 2: Open Wi-Fi Settings -->
        <Button
            android:id="@+id/btnWifiSettings"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="#1E293B"
            android:text="📶 Cài Đặt Wi-Fi"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <!-- Button 3: Switch Stream Protocol -->
        <Button
            android:id="@+id/btnSwitchProtocol"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="#1E293B"
            android:text="🔄 Đổi Giao Thức"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <!-- Button 4: Fullscreen Toggle -->
        <Button
            android:id="@+id/btnFullscreen"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="0.9"
            android:layout_marginHorizontal="3dp"
            android:background="#1E293B"
            android:text="🖥️ Toàn Màn Hình"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <!-- Button 5: Toggle Diagnostics Log -->
        <Button
            android:id="@+id/btnToggleLogs"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="0.8"
            android:layout_marginStart="3dp"
            android:background="#334155"
            android:text="📋 Nhật Ký"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Collapsible Diagnostic Log Console -->
    <LinearLayout
        android:id="@+id/layoutLogConsole"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="6dp"
        android:background="#111827"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NHẬT KÝ KẾT NỐI CAMERA &amp; MẠNG (LIVE DIAGNOSTICS)"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/svLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Khởi tạo ứng dụng xem Camera VietMap..."
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
